# ── Azure AI Foundry (Claude models) ─────────────────────────────────────────
ANTHROPIC_FOUNDRY_API_KEY=your_foundry_api_key_here
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# Full base URL is derived automatically: https://{ANTHROPIC_FOUNDRY_RESOURCE}.services.ai.azure.com/anthropic
# ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic

# Claude deployment names on the Foundry resource
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6

# Which tier to use for RAG pipeline: sonnet | haiku | opus
MODEL_TIER=sonnet

# ── OpenAI fallback (used only when Foundry key is absent) ───────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Embeddings ────────────────────────────────────────────────────────────────
# Option A: Azure OpenAI embeddings (recommended with Foundry)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Option B: Standard OpenAI embeddings (default if Azure vars above are empty)
EMBEDDING_MODEL=text-embedding-3-large

# ── Web search fallback ───────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── SQL Server ────────────────────────────────────────────────────────────────
# SQL Server  : mssql+pyodbc://user:pass@host/db?driver=ODBC+Driver+17+for+SQL+Server
# PostgreSQL  : postgresql+psycopg2://user:pass@host/db
# SQLite      : sqlite:///./data/local.db
SQL_CONNECTION_STRING=

# ── MCP client (Dubai Holding Foundry) ───────────────────────────────────────
# ANTHROPIC_API_KEY falls back to ANTHROPIC_FOUNDRY_API_KEY automatically.
# Only set this if you need a separate direct Anthropic API key.
# ANTHROPIC_API_KEY=
# Bearer token for the Foundry MCP endpoint
FOUNDRY_TOKEN=your_foundry_token_here
# Override MCP endpoint URL if needed (defaults to Dubai Holding Foundry)
# MCP_SERVER_URL=https://foundry.dubaiholding.com/mcp/third-party-application/ri.third-party-applications.main.application.9b7db0c4-8264-4f17-9afc-a09b79bb54d0

# ── Misc ──────────────────────────────────────────────────────────────────────
USER_AGENT=RAG-Pipeline/1.0
